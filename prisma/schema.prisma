generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id                String            @id @default(uuid())
  slug              String            @unique
  name              String
  logoUrl           String?           // Adicionado para a logo da loja
  surname           String
  tagline           String
  heroTitle         String
  heroHighlight     String
  heroDescription   String
  heroImage         String
  aboutTitle        String
  aboutHighlight    String
  since             String
  aboutDescription  String
  aboutSubText      String
  features          String[]
  whatsapp          String
  whatsappDisplay   String
  instagram         String
  instaLink         String
  location          String
  colorPrimary      String
  colorPrimaryHover String
  colorBg           String
  categories        Category[]
  products          Product[]
  users             UserBrandAccess[]
  schedules         OpeningHours[]    // Nova relação de horários
  orders            Order[]
}

model OpeningHours {
  id        String  @id @default(uuid())
  dayOfWeek Int     // 0 (Dom) a 6 (Sáb)
  openTime  String  // Ex: "08:00"
  closeTime String  // Ex: "18:00"
  closed    Boolean @default(false)
  brandId   String
  brand     Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(uuid())
  phone     String   @unique // O telefone será o identificador único
  name      String
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String   @id @default(uuid())
  // displayId: Um número sequencial ou aleatório curto para a cozinha. 
  // No Prisma/Postgres, você pode usar um Int Autoincrement ou gerar via código no Nuxt.
  displayId     Int      @default(autoincrement()) 
  
  status        String   @default("PENDING") // PENDING, PREPARING, DISPATCHED, DELIVERED, CANCELLED
  total         Float
  
  // Salva o snapshot para o lojista ver rápido sem precisar de joins pesados
  items         Json     
  customerName  String?   
  customerPhone String
  
  customer      Customer @relation(fields: [customerPhone], references: [phone])
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now()) // Adicione um default temporário
}

enum OrderStatus {
  PENDING
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String
  brandId     String
  isAvailable Boolean   @default(true)
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([slug, brandId])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  image       String?
  isAvailable Boolean  @default(true)
  brandId     String
  categoryId  String
  createdAt   DateTime @default(now())
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model User {
  id        String            @id @default(cuid())
  email     String            @unique
  password  String
  name      String?
  role      Role              @default(ADMIN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  pushToken String?
  brands    UserBrandAccess[]
}

model UserBrandAccess {
  userId     String
  brandId    String
  assignedAt DateTime @default(now())
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, brandId])
}

enum Role {
  ADMIN
  SUPER_ADMIN
}