enum Role {
  ADMIN
  SUPER_ADMIN
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id      String @id @default(uuid())
  slug    String @unique
  name    String
  surname String
  tagline String

  // Hero Section
  heroTitle       String
  heroHighlight   String
  heroDescription String
  heroImage       String

  // About Section
  aboutTitle       String
  aboutHighlight   String
  since            String
  aboutDescription String
  aboutSubText     String
  features         String[] // Prisma suporta arrays em PostgreSQL. Se usar MySQL/SQLite, use String separada por vírgula.

  // Contact
  whatsapp        String
  whatsappDisplay String
  instagram       String
  instaLink       String
  location        String

  // Design
  colorPrimary      String
  colorPrimaryHover String
  colorBg           String

  categories Category[]
  products   Product[]
  user  User?
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String
  brandId     String // FK para Brand
  isAvailable Boolean   @default(true)
  products    Product[] // Lado "Um" da relação
  brand       Brand     @relation(fields: [brandId], references: [id])

  @@unique([slug, brandId]) // Garante que a slug seja única dentro daquela marca
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String
  price       Float
  image       String?
  isAvailable Boolean @default(true)

  brand      Brand    @relation(fields: [brandId], references: [id])
  brandId    String // Chave estrangeira que conecta ao ID da Brand
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String // Chave estrangeira que conecta ao ID da Category

  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Aqui guardaremos o HASH, nunca a senha real
  name      String?
  role      Role     @default(ADMIN)
  
  // Relação com a Marca
  brand     Brand?   @relation(fields: [brandId], references: [id])
  brandId   String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}