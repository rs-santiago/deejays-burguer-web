enum Role {
  ADMIN
  SUPER_ADMIN
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id      String @id @default(uuid())
  slug    String @unique
  name    String
  surname String
  tagline String

  // Hero Section
  heroTitle       String
  heroHighlight   String
  heroDescription String
  heroImage       String

  // About Section
  aboutTitle       String
  aboutHighlight   String
  since            String
  aboutDescription String
  aboutSubText     String
  features         String[] // Prisma suporta arrays em PostgreSQL

  // Contact
  whatsapp        String
  whatsappDisplay String
  instagram       String
  instaLink       String
  location        String

  // Design
  colorPrimary      String
  colorPrimaryHover String
  colorBg           String

  categories Category[]
  products   Product[]
  
  // 1. RELAÇÃO ATUALIZADA: Uma marca pode ser gerenciada por vários usuários
  users      UserBrandAccess[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String
  brandId     String // FK para Brand
  isAvailable Boolean   @default(true)
  products    Product[] // Lado "Um" da relação
  
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([slug, brandId]) // Garante que a slug seja única dentro daquela marca
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String? // Coloquei opcional com '?' baseado na nossa alteração anterior
  price       Float
  image       String? // Opcional para o upload de imagem
  isAvailable Boolean @default(true)

  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId    String // Chave estrangeira que conecta ao ID da Brand
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String // Chave estrangeira que conecta ao ID da Category

  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Aqui guardaremos o HASH, nunca a senha real
  name      String?
  role      Role     @default(ADMIN)
  
  // 2. RELAÇÃO ATUALIZADA: Um usuário pode ter acesso a várias marcas
  brands    UserBrandAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 3. NOVA TABELA: O "coração" do sistema Multi-Loja
model UserBrandAccess {
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId    String

  assignedAt DateTime @default(now())

  // A chave primária é composta pelos dois IDs. 
  // Isso garante que um usuário não seja adicionado duas vezes à mesma loja.
  @@id([userId, brandId]) 
}