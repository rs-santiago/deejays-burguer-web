generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  price       Float
  image       String
  category    String   // Ex: 'burger', 'hotdog', 'drink'
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
}